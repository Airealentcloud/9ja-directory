# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Site URL (used for canonical URLs + payment callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment safety switches
DEPLOYMENT_ENV=development
# Keep false on public staging until test Supabase/Paystack/Resend are configured.
STAGING_MUTATIONS_ENABLED=false
# Keep production workers.dev previews read-only until an explicit test window.
PREVIEW_MUTATIONS_ENABLED=false
CRON_JOBS_ENABLED=false

# Server-only Supabase key (required for webhook/cron/admin email queue processing)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Paystack Payment Configuration
# Get these from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="9jaDirectory <no-reply@yourdomain.com>"
ADMIN_EMAIL=admin@yourdomain.com

# Optional AI and analytics integrations
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-domain-restricted-key

# Optional: protect cron endpoints
CRON_SECRET=change-me
